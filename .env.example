# svc-analysis-bi — environment configuration (example)
#
# Copy to `.env` and fill in the secrets. All variables are read by
# configs/config.go (Load). Values shown are the built-in defaults unless
# marked (required). Booleans use Go strconv.ParseBool (true/false/1/0).

# ─── Server ──────────────────────────────────────────────────────
PORT=8080
SERVER_HOST=0.0.0.0

# ─── Database (dedicated analytical PostgreSQL) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=                       # (required)
DB_PASSWORD=                   # (required) — secret
DB_NAME=analysis_bi
DB_MAX_CONNS=10
DB_IDLE_TIMEOUT=5m             # Go duration (e.g. 30s, 5m, 1h)

# ─── NATS JetStream (durable, at-least-once consumer) ────────────
NATS_URL=nats://localhost:4222
NATS_STREAM=SOCIAL_CARE_EVENTS
NATS_CONSUMER=analysis-bi

# ─── Auth — Authentik OIDC (JWT RS256 verification) ──────────────
# This service validates the END-USER token forwarded by the web BFF
# (Authorization: Bearer <jwt>). Roles arrive in the Authentik `groups`
# claim as "<system>:<role>" (e.g. analysis-bi:analyst) plus the global
# "superadmin"; admin/role checks are system-scoped to "analysis-bi".
#
# Authentik derives issuer/JWKS from the provider's application slug:
#   AUTH_ISSUER = <AUTHENTIK_URL>/application/o/<slug>/
#   JWKS_URL    = <AUTHENTIK_URL>/application/o/<slug>/jwks/
# The <slug> / issuer MUST match the Authentik provider that ISSUES the
# user tokens consumed here (i.e. the same provider the web BFF logs into),
# and stay consistent across services. Confirm against ADR-009 + the
# Authentik provider config before deploy.
AUTH_REQUIRED=true             # if true, JWKS_URL is required or startup aborts
JWKS_URL=https://auth.acdg-bv.org.br/application/o/<slug>/jwks/
AUTH_ISSUER=https://auth.acdg-bv.org.br/application/o/<slug>/
AUTH_AUDIENCE=                 # optional; if set, token `aud` must contain it

# ─── Anonymization ───────────────────────────────────────────────
# One-way salted SHA-256 of patientId. Rotating it breaks dedup continuity —
# treat as a long-lived credential. Never commit the real value.
PATIENT_HASH_SALT=             # (required) — secret

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info                 # debug | info | warn | error
